# AutoClip Development Environment Dockerfile
FROM python:3.9-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    ffmpeg \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy Python dependency files
COPY requirements.txt ./

# Create virtual environment and install Python dependencies
RUN python3 -m venv venv
RUN . venv/bin/activate && pip install --upgrade pip
RUN . venv/bin/activate && pip install -r requirements.txt

# Copy project files
COPY . .

# Copy development environment startup script
COPY docker-dev-entrypoint.sh ./

# Create necessary directories
RUN mkdir -p data/projects data/uploads data/temp data/output logs

# Set permissions
RUN chmod +x *.sh
RUN chmod +x docker-dev-entrypoint.sh

# Expose port
EXPOSE 8000

# Startup command
CMD ["./docker-dev-entrypoint.sh"]
