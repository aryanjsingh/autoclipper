# AutoClip 环境变量配置示例
# 复制此文件为 .env 并填入实际配置

# 数据库配置
DATABASE_URL=sqlite:///./data/autoclip.db

# Redis配置
REDIS_URL=redis://localhost:6379/0

# API配置
# Kiro Gateway (default AI provider)
# Leave API_KIRO_GATEWAY_API_KEY empty to auto-read ../kiro-gateway/.env PROXY_API_KEY
API_KIRO_GATEWAY_API_KEY=
API_KIRO_GATEWAY_URL=http://127.0.0.1:9000/v1
API_KIRO_MODEL_NAME=claude-sonnet-4-5

# Legacy/provider-specific keys
API_DASHSCOPE_API_KEY=your_dashscope_api_key_here
API_MODEL_NAME=claude-sonnet-4-5
API_MAX_TOKENS=4096
API_TIMEOUT=30

# 处理配置
PROCESSING_CHUNK_SIZE=5000
PROCESSING_MIN_SCORE_THRESHOLD=0.7
PROCESSING_MAX_CLIPS_PER_COLLECTION=5
PROCESSING_MAX_RETRIES=3

# 路径配置（可选，系统会自动检测）
# PATH_PROJECT_ROOT=
# PATH_DATA_DIR=
# PATH_UPLOADS_DIR=
# PATH_TEMP_DIR=
# PATH_OUTPUT_DIR=

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=backend.log

# 环境配置
ENVIRONMENT=development
DEBUG=true

# Output language for AI titles, outlines, and UI category labels (en | zh)
AUTOCLIP_OUTPUT_LANGUAGE=en
SPEECH_RECOGNITION_LANGUAGE=en
